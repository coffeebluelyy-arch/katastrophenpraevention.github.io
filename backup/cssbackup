    align-items: center;
    justify-content: space-between;
    gap: 32px;
}

.footer-column {
    flex: 1;
    min-width: 0;
}

.footer-names {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
}

.footer-names p {
    margin: 0;
    color: #001d3d;
    font-size: 24px;
    line-height: 1.15;
    font-weight: 700;
}

.footer-rights {
    display: flex;
    justify-content: center;
